
{
    "talk_time_01" : "\uAC00\uB054\uC740 \uD734\uC2DD\uB3C4 \uC911\uC694\uD574.\n\uD568\uAED8 \uCC28 \uD55C \uC794 \uD558\uC9C0 \uC54A\uC744\uB798?",
    "talk_time_02" : "\uC624\uB298\uB3C4 \uB77C\uC774\uBE0C\uB791 \uB808\uC2A8,\n\uC5F4\uC2EC\uD788 \uD560\uAC8C\uC694!",
    "talk_time_03" : "\uD56D\uC0C1 \uC751\uC6D0\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC!\n\uB098\uB3C4 \uBAA8\uB450\uB97C \uC751\uC6D0\uD558\uACE0 \uC788\uC5B4!",
    "talk_time_04" : "\uC660\uC9C0 \uC624\uB79C\uB9CC\uC5D0\n\uB0E5\uB0E5\uC5D0\uC11C \uBC25 \uBA39\uACE0 \uC2F6\uB2E4",
    "talk_time_05" : "\uB0B4 \uB178\uB798\uB85C \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774\n\uC6C3\uC744 \uC218 \uC788\uC73C\uBA74 \uC88B\uACA0\uC5B4\uC694",
    "talk_time_06" : "\uC5B4\uB77C? \uC544\uBB34\uB3C4 \uC5C6\uB124...\n\uC5B4\uB514\uB85C \uAC04 \uAC78\uAE4C?",
    "talk_time_07" : "\u266A~",
    "talk_time_08" : "\uB2E4\uC2DC \uC77C\uD558\uB7EC \uAC00\uAE30 \uC804\uC5D0\n\uC7A0\uC2DC \uD734\uC2DD\uC744 \uCDE8\uD574\uBCFC\uAE4C",
    "talk_login_01" : "\uC88B\uC740 \uC544\uCE68!\n\uC624\uB298\uB3C4 \uAC19\uC774 \uD798\uB0B4\uC790!",
    "talk_login_02" : "\uBC30\uACE0\uD504\uB2E4~. \uADF8\uB807\uC9C0,\n\uC810\uC2EC \uBA39\uC73C\uB7EC \uB370\uB824\uB2E4 \uC904\uB798?",
    "talk_login_03" : "\uC544\uB984\uB2E4\uC6B4 \uC11D\uC591...\n\uB2E4\uB4E4 \uAC74\uAC15\uD558\uAC8C \uC798 \uC9C0\uB0B4\uACE0 \uC788\uC73C\uB824\uB098\u2026",
    "talk_login_04" : "\uBC24\uC758 \uB3C4\uC2DC\uB294 \uC815\uB9D0 \uD765\uBBF8\uC9C4\uC9C4\uD558\uB124.\n\uC800\uAE30, \uBC16\uC5D0 \uB098\uAC00\uBCFC\uB798?",
    "talk_login_05" : "\uC544\uC9C1 \uAE68\uC5B4 \uC788\uC5B4?\n\uD6C4\uC544\uC544~... \uC878\uB9AC\uB2E4",
    "talk_comeback_01" : "\uC5ED\uC2DC,\n\uB3CC\uC544\uC62C \uC904 \uC54C\uC558\uC5B4",
    "talk_comeback_02" : "\uC624\uB298\uB3C4 \uAC19\uC774 \uD798\uB0B4\uBCF4\uC790",
    "talk_birthday_01" : "\uC800\uAE30, \uC120\uBB3C \uAE30\uB300\uD574\uB3C4 \uB420\uAE4C?\n...\uB18D\uB2F4\uC774\uC57C!",
    "talk_event_01"    : "\uC124\uB0A0\uC774\uB124...\n\uB098\uC911\uC5D0 \uCD08\uC2DC\uACF5 \uB124\uD2B8\uC6CC\uD06C\uC758 \uBAA8\uB450\uC5D0\uAC8C\n\uC0C8\uD574 \uC778\uC0AC \uD574\uC57C\uC9C0!",
    "talk_event_02"    : "\uBC1C\uB80C\uD0C0\uC778\uB370\uC774\uB294 \uBA4B\uC9C4 \uB0A0\uC774\uB124!\n\uC65C\uB0D0\uBA74 \uB2E4\uB4E4 \uD589\uBCF5\uD574 \uBCF4\uC774\uC796\uC544!",
    "talk_event_03"    : "\uC624\uB298\uC740 \uC808\uBD84\uC774\uB124!\n\uC62C\uD574\uB294 \uCF69 \uBFCC\uB9AC\uAE30, \uC5B4\uB5BB\uAC8C \uD560\uAE4C...?",
    "talk_event_04"    : "\uD788\uB098\uC778\uD615\uC744 \uC7A5\uC2DD\uD558\uB824\uACE0 \uD558\uB294\uB370...\n\uC5B4\uB514\uC5D0 \uC7A5\uC2DD\uD560\uAE4C?",
    "talk_event_05"    : "\uC640\uC544, \uBC1C\uB80C\uD0C0\uC778\uB370\uC774\uC758\n\uB2F5\uB840\uD488\uC744 \uC8FC\uB294 \uAC70\uC57C? \uACE0\uB9C8\uC6CC!",
    "talk_event_06"    : "\uC624\uB298\uC740 \uB9CC\uC6B0\uC808!\n\uBC8C\uC368 \uB808\uC774\uB098\uC5D0\uAC8C \uC18D\uC544\n\uB118\uC5B4\uAC00 \uBC84\uB838\uC5B4",
    "talk_event_07"    : "\uC2A4\uD29C\uB514\uC624\uC5D0\uC11C \uBAB0\uB798\n\uBE60\uC838\uB098\uAC08\uAE4C?\n\uB180\uB7EC \uAC00\uACE0 \uC2F6\uC5B4",
    "talk_event_08"    : "\uC608\uC05C \uC6E8\uB529\uB4DC\uB808\uC2A4...\n\uC5B8\uC820\uAC00 \uB098\uB3C4 \uC785\uC744 \uB0A0\uC774 \uC62C\uAE4C?",
    "talk_event_09"    : "\uCE60\uC11D\uC774\uB77C\uB2C8...\n\uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uC744 \uB9CC\uB098\uC9C0 \uBABB\uD558\uB294 \uAC74\n\uC815\uB9D0 \uD798\uB4E0 \uC77C\uC774\uC9C0\u2026",
    "talk_event_10"    : "\uB354\uC6B4 \uC5EC\uB984\uC5D0\uB294, \uB0E5\uB0E5\uC73C\uB85C!\n\uB9DB\uC788\uB294 \uC911\uD654\uC694\uB9AC\uB85C \uC5EC\uB984\uC744 \uC774\uACA8\uB0B4\uC790!",
    "talk_event_11"    : "\uD070 \uBD88\uAF43\uB180\uC774\uAC00 \uBCF4\uC600\uC5B4!\n\uC5B4\uB514\uC120\uAC00\n\uCD95\uC81C\uB77C\uB3C4 \uD558\uB294 \uAC78\uAE4C...?",
    "talk_event_12"    : "\uB2EC\uB9DE\uC774 \uB2F9\uACE0, \uD1A0\uB780, \uC5D0\uB2E4\uB9C8\uBA54...\n\uB2EC\uB2D8\uC740 \uC2DD\uD0D0\uC774 \uB9CE\uC73C\uC2DC\uB124",
    "talk_event_13"    : "\uC624\uB298\uC740 \uD560\uB85C\uC708!\n\uBB34\uC2A8 \uC7A5\uB09C\uC744 \uCE60\uAE4C?",
    "talk_event_14"    : "\uB098, \uCD95\uC81C \uC88B\uC544\uD574!\n\uC800\uAE30, \uAC19\uC774 \uAD6C\uACBD\uD558\uB7EC \uAC00\uC790!",
    "talk_event_15"    : "\uD06C\uB9AC\uC2A4\uB9C8\uC2A4\uB77C...\n\uB85C\uB9E8\uD2F1\uD55C\n\uB77C\uC774\uBE0C\uB97C \uD558\uACE0 \uC2F6\uC5B4!",
    "talk_event_16"    : "\uBC8C\uC368 \uC123\uB2EC \uADF8\uBBD0\uC778\uAC00... \uB0B4\uB144\uC5D0\uB3C4\n\uC544\uC8FC \uBA4B\uC9C4 \uD55C \uD574\uAC00 \uB418\uAE30\uB97C",
