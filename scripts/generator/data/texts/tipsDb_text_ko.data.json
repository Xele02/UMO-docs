    "tips_0001_msg"   : "\uBC1C\uB3D9\uD558\uBA74 \uB77C\uC774\uD504\uAC00 \uD68C\uBCF5\uB3FC\r\n\uACE4\uACBD\uC5D0 \uCC98\uD588\uC744 \uB54C \uAD6C\uD574\uC904 \uC218 \uC788\uB294 \uC2A4\uD0AC\uC774\uC9C0",
    "tips_0002_title" : "\u3010\uC2A4\uD0AC\u3011\uB300\uBBF8\uC9C0 \uAC10\uC18C\uAC00 \uBB50\uC57C?",
