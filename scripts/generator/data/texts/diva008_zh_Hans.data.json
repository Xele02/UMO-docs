    "talk_event_25"        : "\u4ECA\u5929\u662F\u857E\u5A1C\u7684\u751F\u65E5\uFF0C\n\u739B\u57FA\u5A1C\u7B80\u76F4\u6BD4\u5BFF\u661F\u8FD8\u8981\u5F00\u5FC3\u5462\uFF01\n\u5979\u4EEC\u4FE9\u7684\u5173\u7CFB\u53EF\u771F\u597D\u5440\uFF01",
    "talk_event_26"        : "\u751F\u65E5\u5FEB\u4E50\u5170\u5361\uFF01\n\u656C\u8BF7\u671F\u5F85\u4ECA\u665A\u7684\u751F\u65E5\u805A\u4F1A\u54E6\uFF01",
    "talk_event_27"        : "\u96EA\u8389\u9732\u7684\u751F\u65E5\u6F14\u51FA\n\u597D\u50CF\u529E\u5F97\u7279\u522B\u8C6A\u534E\u5462\uFF01\n\u6211\u4E5F\u597D\u60F3\u53BB\u770B\uFF01",
    "talk_event_28"        : "\u7C73\u83B2",
    "talk_event_29"        : "\u7EA0\u7ED3\u4E86\u5F88\u4E45\u2026\u55EF\uFF01\n\u6700\u9002\u5408\u5DF4\u8428\u62C9\u7684\u751F\u65E5\u793C\u7269\uFF0C\n\u679C\u7136\u8FD8\u662F\u5531\u6B4C\u7ED9\u4ED6\u542C\uFF01",
    "talk_event_30"        : "\u660E\u7F8E\u5C0F\u59D0\u7684\u751F\u65E5\u5230\u4E86\uFF0C\u4E0D\u77E5\u9053\n\u5979\u4ECA\u5929\u662F\u600E\u4E48\u5EA6\u8FC7\u7684\u2026\u8FD8\u6709\u90FD\n\u6536\u5230\u4E86\u4E9B\u4EC0\u4E48\u6837\u7684\u793C\u7269\u5462\uFF0C\u597D\u597D\u5947\uFF01",
    "talk_event_31"        : "\u75BE\u98CE",
