    "talk_event_41"        : "\u672A\u6C99",
    "talk_event_42"        : "\u542C\u8BF4\u6211\u4EEC\u7684\u7535\u5F71\u4E0A\u6620\u4E86\uFF01\n\u597D\u671F\u5F85\u5440\uFF01",
    "talk_event_43"        : "\u8C22\u8C22\u4F60\u4E00\u76F4\u4EE5\u6765\u7684\u7167\u987E\uFF01\u591A\u4E8F\u6709\u4F60\uFF0C\n\u6211\u4EEC\u7684\u6F14\u51FA\u4E5F\u5706\u6EE1\u5730\u5B8C\u6210\u5566\uFF01\n\u5C06\u6765\u6709\u673A\u4F1A\uFF0C\u4E00\u5B9A\u8981\u518D\u4E00\u8D77\u5531\u6B4C\uFF01",
    "talk_event_44"        : "\u672A\u6765\u7684\u8DEF\uFF0C\u6211\u76F8\u4FE1\u4F60\u53EF\u4EE5\u597D\u597D\u8D70\u4E0B\u53BB\u3002\n\u4F46\u5DF4\u8428\u62C9\u4E0D\u4E00\u6837\uFF01\u4E0D\u597D\u597D\u770B\u7740\u4ED6\uFF0C\n\u4E00\u4E0D\u7559\u795E\u5C31\u4E0D\u77E5\u9053\u8DD1\u54EA\u53BB\u4E86\u2026\uFF01",
    "talk_event_45"        : "\u56DE\u5230\u539F\u672C\u7684\u65F6\u7A7A\u540E\uFF0C\n\u8FD8\u6709\u8BB8\u591A\u4E8B\u60C5\u7B49\u5F85\u7740\u6211\u4EEC\u53BB\u505A\uFF01\n\u4ECE\u4ECA\u5F80\u540E\u4E5F\u8981\u7EE7\u7EED\u52A0\u6CB9\uFF01",
    "talk_event_46"        : "\u6211\u4EEC\u4E50\u961F\u5728\u672A\u6765\u7684\u65F6\u7A7A\uFF0C\n\u5C45\u7136\u4F1A\u6709\u8FD9\u4E48\u5927\u7684\u5F71\u54CD\u529B\u3002\n\u65E2\u7136\u8FD9\u6837\uFF0C\u6211\u4E5F\u5F97\u52A0\u500D\u52AA\u529B\u624D\u884C\uFF01",
    "talk_event_47"        : "\u56DE\u53BB\u540E\uFF0C\u7238\u7238\u5988\u5988\u5012\u8FD8\u662F\u80FD\u60F3\u89C1\u5C31\u89C1\uFF0C\n\u4F46\u6211\u8FD8\u80FD\u518D\u89C1\u5230\u660E\u7F8E\u5C0F\u59D0\u5417\u2026\n\u4E34\u8D70\u524D\uFF0C\u518D\u53BB\u548C\u5979\u9053\u4E2A\u522B\u5427\uFF01"
