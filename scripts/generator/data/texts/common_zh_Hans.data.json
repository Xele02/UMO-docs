    "profile_diva001_description_gakuya"              : "\u56E0\u5BF9\u6218\u672F\u97F3\u4E50\u7EC4\u5408\u201CWalk\u00FCre\u201D\u5FC3\u751F\u5411\u5F80\n\u800C\u79BB\u5F00\u5BB6\u4E61\u5916\u51FA\u95EF\u8361\u7684\u5973\u5B69\u3002\n\u5FC3\u5730\u7EAF\u6D01\u5584\u826F\uFF0C\u975E\u5E38\u559C\u6B22\u5531\u6B4C\uFF0C\n\u4F46\u4E0D\u64C5\u957F\u821E\u8E48\u3002\n\n\u5934\u4E0A\u7684\u5668\u5B98\u201CRune\u201D\u4F1A\u5728\u5174\u594B\u65F6\u4EAE\u8D77\u3002\n\u8BF4\u8BDD\u5E26\u6709\u7279\u522B\u7684\u53E3\u97F3\uFF0C\u5E38\u628A\u201CGoriGori\u201D\u6302\u5728\u5634\u8FB9\u3002",
    "profile_diva002_description_gakuya"              : "\u6218\u672F\u97F3\u4E50\u7EC4\u5408\u201CWalk\u00FCre\u201D\u7684\u4E3B\u5531\u3002\n\u8EAB\u4E16\u6210\u8C1C\uFF0C\u65E0\u4EBA\u77E5\u6653\u5979\u7684\u8FC7\u53BB\u3002\n\u5B9B\u5982\u8C1C\u56E2\u4E00\u822C\u7684\u5B58\u5728\u3002\n\n\u5BF9\u5531\u6B4C\u6709\u7740\u5F3A\u70C8\u7684\u6267\u7740\uFF0C\n\u65E0\u8BBA\u9762\u4E34\u600E\u6837\u7684\u5371\u673A\u90FD\n\u4E0D\u4F1A\u653E\u5F03\u6B4C\u5531\u3002",
    "profile_diva003_description_gakuya"              : "\u6218\u672F\u97F3\u4E50\u7EC4\u5408\u201CWalk\u00FCre\u201D\u7684\u9886\u961F\u3002\n\u64C5\u957F\u5904\u7406\u961F\u4F0D\u7684\u65E5\u7A0B\u5B89\u6392\uFF0C\n\u5341\u5206\u53EF\u9760\uFF0C\u662F\u7BA1\u7406\u7684\u4E00\u628A\u597D\u624B\u3002\n\n\u5728\u52A0\u5165Walk\u00FCre\u4E4B\u524D\uFF0C\n\u66FE\u662F\u4E00\u540D\u4E2A\u4EBA\u5076\u50CF\u3002",
    "profile_diva004_description_gakuya"              : "\u6218\u672F\u97F3\u4E50\u7EC4\u5408\u201CWalk\u00FCre\u201D\u7684\u6210\u5458\u3002\n\u51FA\u8EAB\u4E8E\u673A\u68B0\u5E08\u4E16\u5BB6\uFF0C\u81EA\u8EAB\n\u4E5F\u662F\u4E00\u540D\u6280\u827A\u9AD8\u8D85\u7684\n\u673A\u68B0\u5E08\u3002\n\n\u559C\u6B22\u7ED9\u540C\u4F34\u548C\u673A\u5668\u8D77\u5916\u53F7\u3002\n\u548C\u857E\u5A1C\u60C5\u540C\u59D0\u59B9\u3002",
    "profile_diva005_description_gakuya"              : "\u6218\u672F\u97F3\u4E50\u7EC4\u5408\u201CWalk\u00FCre\u201D\u7684\u6210\u5458\u3002\n\u8BF4\u8BDD\u6BD2\u820C\uFF0C\u5916\u8868\u51B7\u6F20\uFF0C\n\u662F\u4E00\u540D\u5728\u7535\u5B50\u9886\u57DF\n\u53F1\u54A4\u98CE\u4E91\u7684\u9ED1\u5BA2\u9AD8\u624B\u3002\n\n\u548C\u739B\u57FA\u5A1C\u5173\u7CFB\u975E\u5E38\u8981\u597D\uFF0C\u751A\u81F3\n\u751F\u6D3B\u8D77\u5C45\u4E5F\u5728\u4E00\u8D77\u3002",
    "profile_diva006_description_gakuya"              : "\u5728\u673A\u7F18\u5DE7\u5408\u4E0B\u5F97\u4EE5\u51FA\u9053\uFF0C\n\u4E00\u8DC3\u6210\u4E3A\u4EBA\u6C14\u5076\u50CF\u7684\n\u201C\u8D85\u65F6\u7A7A\u7070\u59D1\u5A18\u201D\u3002\n\n\u6027\u683C\u6E29\u67D4\u5584\u826F\uFF0C\u505A\u4E8B\u52E4\u594B\u523B\u82E6\u3002\n\u4ECE\u5C0F\u5C31\u5341\u5206\u559C\u6B22\u5531\u6B4C\uFF0C\n\u5BF9\u96EA\u8389\u9732\u6000\u6709\u4EF0\u6155\u4E4B\u60C5\u3002",
    "profile_diva007_description_gakuya"              : "\u6B4C\u58F0\u88AB\u8A89\u4E3A\u201C\u94F6\u6CB3\u5C45\u6C11\u6BCF\u5929\n\u7684\u751F\u6D3B\u5FC5\u9700\u54C1\u201D\u7684\u9876\u5C16\u6B4C\u624B\u3002\n\u4EBA\u9001\u5916\u53F7\u201C\u94F6\u6CB3\u5996\u7CBE\u201D\u3002\n\n\u5BF9\u81EA\u5DF1\u4E13\u4E1A\u6B4C\u624B\u7684\u8EAB\u4EFD\u611F\u5230\u81EA\u8C6A\uFF0C\n\u540C\u65F6\u4E0D\u9057\u4F59\u529B\u5730\u4FDD\u6301\u7740\u4E00\u6D41\u6C34\u51C6\u3002",
    "profile_diva008_description_gakuya"              : "\u6447\u6EDA\u4E50\u961F\u201CFire Bomber\u201D\u7684\n\u4E3B\u5531\u517C\u8D1D\u65AF\u624B\u3002\n\u5728\u4E03\u59D0\u59B9\u4E2D\u6392\u884C\u8001\u5E7A\u3002\n\u6027\u683C\u76F4\u723D\uFF0C\u6562\u60F3\u6562\u505A\uFF0C\n\u8BA8\u538C\u88AB\u5F53\u4F5C\u5C0F\u5B69\u770B\u5F85\u3002\n\u65E0\u8BBA\u662F\u4F5C\u4E3A\u6B4C\u624B\u8FD8\u662F\u98DE\u884C\u5458\uFF0C\n\u90FD\u6709\u4E0D\u900A\u4E8E\u5DF4\u8428\u62C9\u7684\u5B9E\u529B\u3002",
    "profile_diva009_description_gakuya"              : "\u6447\u6EDA\u4E50\u961F\u201CFire Bomber\u201D\u7684\n\u4E3B\u5531\u517C\u5409\u4ED6\u624B\u3002\n\u59CB\u7EC8\u628A\u5531\u6B4C\u653E\u5728\u7B2C\u4E00\u4F4D\uFF0C\n\u4E0D\u559C\u6B22\u53C2\u4E0E\u4E89\u7AEF\u3002\n\u89C1\u4EBA\u5C31\u6765\u4E00\u53E5\u201C\u542C\u6211\u7684\u6B4C\u5427\uFF01\u201D\u3002\n\u8BA4\u4E3A\u6B4C\u58F0\u53EF\u4EE5\u6D88\u9664\n\u4E16\u4E0A\u7684\u4E00\u5207\u9694\u9602\u3002",
    "profile_diva010_description_gakuya"              : "\u540D\u5782\u9752\u53F2\u7684\u4F20\u5947\u6B4C\u624B\u3002\n\u6027\u683C\u4E50\u89C2\u723D\u6717\uFF0C\n\u4F46\u5076\u5C14\u4E5F\u4F1A\u6709\u4EFB\u6027\u7684\u4E00\u9762\u3002\n\u5979\u7684\u9B45\u529B\u548C\u6B4C\u58F0\uFF0C\u66FE\u4EE4\u4E0E\u4EBA\u7C7B\n\u5175\u620E\u76F8\u5411\u7684\u6770\u7279\u62C9\u5E1D\u4EBA\u4E5F\n\u4E3A\u4E4B\u6298\u670D\uFF0C\u5E76\u7531\u6B64\u9886\u7565\u5230\u4E86\n\u6587\u5316\u7684\u9B45\u529B\u3002",
