    "popup_inh_title_001"              : "\uBE44\uBC00\uBC88\uD638 \uC785\uB825",
    "popup_inh_pass_000"               : "\uD50C\uB808\uC774\uC5B4 ID\uC640 \uBE44\uBC00\uBC88\uD638\uB97C \uC785\uB825\uD558\uBA74\n\uB2E4\uB978 \uAE30\uAE30\uC5D0\uC11C \uD50C\uB808\uC774\uD558\uB358 \uD50C\uB808\uC774 \uB370\uC774\uD130\uB97C\n\uC774\uC5B4\uBC1B\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.",
