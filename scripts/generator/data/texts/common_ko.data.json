    "popup_app_update_an"              : "\uC0C8\uB85C\uC6B4 \uC571 \uBC84\uC804\uC774 \uC788\uC2B5\uB2C8\uB2E4.\nGoogle Play \uC2A4\uD1A0\uC5B4\uC5D0\uC11C\n\uC5C5\uB370\uC774\uD2B8\uB97C \uC9C4\uD589\uD574\uC8FC\uC138\uC694.\n\uC5C5\uB370\uC774\uD2B8\uC5D0 \uC2E4\uD328\uD560 \uACBD\uC6B0, \uB2E8\uB9D0\uAE30\uB97C \uC7AC\uBD80\uD305\uD574 \uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.",
    "popup_app_update_ios"             : "\uC0C8\uB85C\uC6B4 \uC571 \uBC84\uC804\uC774 \uC788\uC2B5\uB2C8\uB2E4.\nApp Store\uC5D0\uC11C\n\uC5C5\uB370\uC774\uD2B8\uB97C \uC9C4\uD589\uD574\uC8FC\uC138\uC694.\n\uC5C5\uB370\uC774\uD2B8\uC5D0 \uC2E4\uD328\uD560 \uACBD\uC6B0, \uB2E8\uB9D0\uAE30\uB97C \uC7AC\uBD80\uD305\uD574 \uC8FC\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4.",
    "cache_clear_00"                   : "\uAC8C\uC784 \uB370\uC774\uD130\uB97C \uC0AD\uC81C\uD558\uACE0 \uB370\uC774\uD130 \uBCF5\uAD6C\uB97C \uC218\uD589\uD569\uB2C8\uB2E4.\n\uAC8C\uC784\uC774 \uC798 \uC2E4\uD589\uB418\uC9C0 \uC54A\uB294 \uACBD\uC6B0 \uB4F1\uC5D0 \uC2DC\uB3C4\uD574 \uBCF4\uC138\uC694.\n\uB370\uC774\uD130 \uBCF5\uAD6C\uB97C \uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\n<color=#c8087e>\u203B\uD50C\uB808\uC774 \uB370\uC774\uD130\uB294 \uC0AD\uC81C\uB418\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.</color>",
    "cache_clear_01"                   : "\uB370\uC774\uD130 \uBCF5\uAD6C\uAC00 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4.",
    "cache_clear_02"                   : "\uB370\uC774\uD130 \uBCF5\uAD6C",
