    "game_popup_retire_text_battle"    : "\uB9AC\uD0C0\uC774\uC5B4\uD558\uBA74 \uBCF4\uC0C1\uC744 \uBC1B\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uAD1C\uCC2E\uC73C\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\n\n<color=#8e0529>\u203BEX \uBC30\uD2C0\uC758 \uACBD\uC6B0 EX \uAC8C\uC774\uC9C0\uAC00 \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4. </color>",
