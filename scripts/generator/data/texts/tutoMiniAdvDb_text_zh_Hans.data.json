
{
    "tuto_miniadv_0000_0000_msg" : "\u51FA\u53D1\u524D\uFF0C\u5148\u6765\u5C06\u97F3\u7B26\u5224\u5B9A\n\u8C03\u6574\u81F3\u6700\u4F73\u72B6\u6001\u5427\u3002",
    "tuto_miniadv_0000_0001_msg" : "\u542C\u5230\u6253\u51FB\u97F3\u6548\u65F6\uFF0C\n\u8BF7\u8BD5\u7740\u70B9\u51FB\u53F3\u4E0B\u89D2\u7684\u6309\u952E\u3002",
    "tuto_miniadv_0001_0000_msg" : "\u8FD9\u6837\u5C31\u8C03\u6574\u5B8C\u6BD5\u4E86\u3002\n\u6211\u4EEC\u51FA\u53D1\u5427\uFF01",
    "tuto_miniadv_0002_0000_msg" : "\u6211\u4E3A\u8FD9\u6B21\u7684\u4EFB\u52A1\u7279\u5730\u7F16\u5199\u4E86\u4E00\u4EFD\u6307\u5357\u3002\n\u4E00\u8D77\u6765\u8BFB\u8BFB\u770B\u5427\u3002",
    "tuto_miniadv_0002_0001_msg" : "\u771F\u4E0D\u6127\u662F\u8981\u59D0\uFF01\n\u6709\u4E86\u8FD9\u4EFD\u6307\u5357\uFF0C\u5C31\u4E0D\u6015\u5FC3\u91CC\u6CA1\u5E95\u5566\uFF01",
    "tuto_miniadv_0003_0000_msg" : "\u2026\u6211\u4EEC\u7684\u6B4C\u58F0\u7ADF\u7136\u5BF9\u5B83\u65E0\u6548\uFF1F\n\u518D\u7EE7\u7EED\u4E0B\u53BB\u4F1A\u5F88\u5371\u9669\uFF0C\n\u8299\u857E\u96C5\uFF0C\u6211\u4EEC\u5148\u64A4\u9000\u5427\uFF01",
    "tuto_miniadv_0004_0000_msg" : "\u6240\u8C13\u201C\u56DE\u5FC6\u5361\u7247\u201D\uFF0C\u5C31\u662F\u5C06\u6B4C\u58F0\u4FEE\u590D\u7684\u8BB0\u5FC6\u8F6C\u5316\u4E3A\u6982\u5FF5\u540E\uFF0C\n\u4EE5\u7535\u5B50\u4FE1\u606F\u7684\u5F62\u5F0F\u50A8\u5B58\u4E0B\u6765\u7684\u4EA7\u7269\u3002",
    "tuto_miniadv_0005_0000_msg" : "\u83B7\u5F97\u201C\u56DE\u5FC6\u5361\u7247\u201D\u7684\u65B9\u5F0F\n\u6709\u5F88\u591A\u79CD\u3002",
    "tuto_miniadv_0005_0001_msg" : "\u8FD9\u6B21\u6211\u4EEC\u5C31\u5148\u901A\u8FC7\u201C\u62BD\u5361\u201D\u6765\u83B7\u53D6\u5427\uFF01",
    "tuto_miniadv_0005_0002_msg" : "\u6211\u5DF2\u7ECF\u51C6\u5907\u597D\u4E86\u62BD\u5361\u6240\u9700\u7684\u201C\u6B4C\u6676\u77F3\u201D\u3002\n\u8BD5\u8BD5\u770B\u80FD\u62BD\u5230\u4EC0\u4E48\u6837\u7684\u5361\u7247\u5427\u3002",
    "tuto_miniadv_0006_0000_msg" : "\u8FD9\u662F\u2026\n\u6211\u901A\u8FC7\u6D77\u9009\u90A3\u5929\u7684\u56DE\u5FC6\u8BF6\uFF1F",
    "tuto_miniadv_0006_0001_msg" : "\u201C\u56DE\u5FC6\u5361\u7247\u201D\u4E4B\u4E2D\uFF0C\n\u4F3C\u4E4E\u8574\u542B\u7740\u4E0E\u6211\u4EEC\u6709\u5173\u7684\u56DE\u5FC6\u5462\u3002",
    "tuto_miniadv_0007_0000_msg" : "\u8981\u53D1\u6325\u201C\u56DE\u5FC6\u5361\u7247\u201D\u7684\u529B\u91CF\uFF0C\n\u5FC5\u987B\u5148\u5C06\u5B83\u88C5\u5907\u5230\u6B4C\u59EC\u8EAB\u4E0A\u3002\n\u8DDF\u6211\u6765\u4E00\u6B65\u6B65\u64CD\u4F5C\u5427\u3002",
    "tuto_miniadv_0008_0000_msg" : "\u70B9\u51FB\u201C\u89D2\u8272\u7F16\u961F\u201D\u3002",
    "tuto_miniadv_0009_0000_msg" : "\u5728\u7F16\u961F\u4E2D\uFF0C\u53EF\u4EE5\u5BF9\u6B4C\u59EC\n\u4EE5\u53CA\u56DE\u5FC6\u5361\u7247\u8FDB\u884C\u7EC4\u5408\u3002",
    "tuto_miniadv_0009_0001_msg" : "\u63A5\u4E0B\u6765\uFF0C\u8BA9\u6211\u4EEC\u88C5\u5907\u4E0A\n\u521A\u624D\u83B7\u5F97\u7684\u56DE\u5FC6\u5361\u7247\u5427\u3002",
    "tuto_miniadv_0010_0000_msg" : "\u56DE\u5FC6\u5361\u7247\u6B63\u5728\u6E90\u6E90\u4E0D\u65AD\u5730\u8F93\u9001\u6B4C\u58F0\u80FD\u91CF\uFF01\n\u8FD9\u6837\u4E00\u6765\uFF0C\u6211\u4EEC\u5C31\u53EF\u4EE5\u53D1\u51FA\n\u66F4\u4E3A\u5F3A\u529B\u7684\u751F\u7269Fold\u6CE2\u4E86\u3002",
    "tuto_miniadv_0011_0000_msg" : "\u5728\u8FD9\u91CC\uFF0C\u4F60\u53EF\u4EE5\u548C\u5168\u94F6\u6CB3\u7684\u4EBA\u4EEC\u8FDB\u884C\n\u8DE8\u8D8A\u65F6\u7A7A\u7684\u4EA4\u6D41\uFF0C\u4E5F\u5305\u62EC\u6211\u4EEC\u5728\u5185\u54E6\u3002",
    "tuto_miniadv_0011_0001_msg" : "\u8DE8\u8D8A\u65F6\u7A7A\u7684\u4EA4\u6D41\uFF1F",
    "tuto_miniadv_0011_0002_msg" : "\u5149\u8FD9\u4E48\u8BF4\u4F60\u4EEC\u53EF\u80FD\u6CA1\u4EC0\u4E48\u6982\u5FF5\uFF0C\u8FD8\u662F\u9A6C\u4E0A\u8DDF\u6211\u6765\u5B9E\u64CD\u4E00\u4E0B\u5427\u3002",
    "tuto_miniadv_0011_0003_msg" : "\u9996\u5148\u662F\u9009\u62E9\u804A\u5929\u5BA4\u3002\n\u8FD9\u6B21\u5C31\u5148\u9009\u62E9\u201CSNS\u8054\u7EDC\u5BA4\u201D\u8BD5\u8BD5\u770B\u5427\u3002",
    "tuto_miniadv_0012_0000_msg" : "\u8FD9\u6837\u5B50\u5C31\u53EF\u4EE5\u4E86\u561B\uFF1F",
    "tuto_miniadv_0012_0001_msg" : "\u6CA1\u9519\uFF0C\u5C31\u662F\u8FD9\u6837\u3002",
    "tuto_miniadv_0013_0000_msg" : "\u54C7\uFF0C\u7F8E\u4E91\u3001\u739B\u57FA\u5A1C\uFF0C\u8FD8\u6709\u857E\u5A1C\u4E5F\u5728\u8036\uFF01\n\u5927\u5BB6\u90FD\u5230\u9F50\u5566\uFF01",
    "tuto_miniadv_0013_0001_msg" : "\u6211\u5DF2\u7ECF\u4E8B\u5148\u8BA9\u5979\u4EEC\u6CE8\u518C\u597D\u4E86\u3002\n\u9A6C\u4E0A\u6765\u53D1\u6D88\u606F\u8BD5\u8BD5\u770B\u5427\uFF01",
    "tuto_miniadv_0014_0000_msg" : "\u8FD9\u4E9B\u662F\u6B63\u5728\u548C\u9E1F\u4EBA\u6218\u6597\n\u7684\u6B4C\u59EC\u4EEC\u7684\u8D44\u6599\u3002",
    "tuto_miniadv_0014_0001_msg" : "\u4E3A\u4E86\u5E94\u5BF9\u9E1F\u4EBA\u7684\u5A01\u80C1\uFF0C\n\u6211\u4EEC\u9700\u8981\u4F60\u548C\u6B4C\u59EC\u4EEC\u7684\u529B\u91CF\uFF0C\n\u4E8C\u8005\u7F3A\u4E00\u4E0D\u53EF\u3002",
    "tuto_miniadv_0014_0002_msg" : "\u8BF7\u9009\u62E9\u4E00\u4F4D\u4F60\u8981\u4E0E\u4E4B\u5E76\u80A9\u4F5C\u6218\u7684\u6B4C\u59EC\u5427\u3002",
    "tuto_miniadv_0014_0003_msg" : "\u76EE\u524D\u7531\u4E8E\u65F6\u7A7A\u8FDE\u63A5\u5C1A\u672A\u7A33\u5B9A\uFF0C\n\u6211\u4EEC\u6682\u65F6\u8FD8\u65E0\u6CD5\u4E0E\u5DF4\u8428\u62C9\u5148\u751F\n\u548C\u7C73\u83B2\u5C0F\u59D0\u8FDB\u884C\u5408\u4F5C\u3002",
    "tuto_miniadv_0014_0004_msg" : "\u4F46\u8FD8\u8BF7\u653E\u5FC3\uFF0C\u76F8\u4FE1\u4ED6\u4EEC\u5F88\u5FEB\u5C31\u4F1A\u6210\u4E3A\u6211\u4EEC\u961F\u4F0D\u7684\u4E00\u5458\u7684\u3002",
    "tuto_miniadv_0015_0000_msg" : "\u4F60\u597D\uFF0C\u5F88\u9AD8\u5174\u8BA4\u8BC6\u4F60\u3002\n\u6211\u53EB\u8981\u00B7\u5DF4\u5361\u59AE\u96C5\u3002",
    "tuto_miniadv_0015_0001_msg" : "\u63A5\u4E0B\u6765\u5C06\u7531\u6211\u5E26\u9886\u4F60\u719F\u6089\u5404\u9879\u7CFB\u7EDF\u7684\u8FD0\u4F5C\uFF0C\n\u8BF7\u591A\u6307\u6559\u5566\u3002",
    "tuto_miniadv_0015_0002_msg" : "\u5165\u961F\u793C\u7269\u5DF2\u7ECF\u53D1\u9001\u5230\u4F60\u7684\u793C\u7269\u7BB1\u4E86\uFF01\n\u6211\u624B\u4E0A\u8FD8\u6709\u51E0\u5F20\u56DE\u5FC6\u5361\u7247\uFF0C\n\u987A\u4FBF\u4E00\u8D77\u9001\u4F60\u5427\u3002",
    "tuto_miniadv_0016_0000_msg" : "\u4F60\u597D\uFF0C\u5F88\u9AD8\u5174\u8BA4\u8BC6\u4F60\u3002\n\u6211\u53EB\u8981\u00B7\u5DF4\u5361\u59AE\u96C5\u3002",
    "tuto_miniadv_0016_0001_msg" : "\u63A5\u4E0B\u6765\u5C06\u7531\u6211\u5E26\u9886\u4F60\u719F\u6089\u5404\u9879\u7CFB\u7EDF\u7684\u8FD0\u4F5C\uFF0C\n\u8BF7\u591A\u6307\u6559\u5566\u3002",
    "tuto_miniadv_0016_0002_msg" : "\u5165\u961F\u793C\u7269\u5DF2\u7ECF\u53D1\u9001\u5230\u4F60\u7684\u793C\u7269\u7BB1\u4E86\uFF01\n\u6211\u624B\u4E0A\u8FD8\u6709\u51E0\u5F20\u56DE\u5FC6\u5361\u7247\uFF0C\n\u987A\u4FBF\u4E00\u8D77\u9001\u4F60\u5427\u3002",
    "tuto_miniadv_0017_0000_msg" : "\u73B0\u5728\u53EF\u4EE5\u83B7\u53D6\u8299\u857E\u96C5\u7684\u6F14\u51FA\u670D\u4E86\u3002\n\u4E8B\u4E0D\u5B9C\u8FDF\uFF0C\u9A6C\u4E0A\u70B9\u51FB\u201C\u6311\u6218\u201D\u53BB\u5B8C\u6210\u4EFB\u52A1\u5427\uFF01",
    "tuto_miniadv_0018_0000_msg" : "\u4F60\u5DF2\u7ECF\u5B8C\u6210\u4E86\u6240\u6709\u7684\u65B0\u624B\u4EFB\u52A1\uFF0C\n\u5E72\u5F97\u4E0D\u9519\uFF01",
    "tuto_miniadv_0018_0001_msg" : "\u53EF\u4EE5\u7EE7\u7EED\u5B8C\u6210\u5176\u4ED6\u4EFB\u52A1\u6765\u83B7\u5F97\u66F4\u591A\u5956\u52B1\u54E6\u3002\n\u4EFB\u52A1\u7684\u5F62\u5F0F\u591A\u79CD\u591A\u6837\uFF0C\u9A6C\u4E0A\u6765\u4E86\u89E3\u4E00\u4E0B\u5427\u3002",
    "tuto_miniadv_0019_0000_msg" : "\u53EA\u8981\u50CF\u5F80\u5E38\u4E00\u6837\u5531\u6B4C\u5C31\u597D\u4E86\u5427\u3002\n\u6211\u4F1A\u52A0\u6CB9\u7684\uFF01",
    "tuto_miniadv_0020_0000_msg" : "\u600E\u4E48\u6837\uFF1F\u70B9\u51FB\u6309\u94AE\u65F6\uFF0C\n\u97F3\u7B26\u8981\u4E0E\u6309\u94AE\u521A\u597D\u91CD\u5408\n\u624D\u7B97\u662F\u6700\u4F73\u72B6\u6001\u54E6\u3002",
    "tuto_miniadv_0021_0000_msg" : "\u8981\u9009\u62E9<SelDiva>\u5417\uFF1F",
    "tuto_miniadv_0022_0000_msg" : "\u5728\u8FD9\u91CC\u53EF\u4EE5\u770B\u5230\u6240\u6709\u5DF2\u83B7\u5F97\u7684\u56DE\u5FC6\u7247\u6BB5\u3002",
    "tuto_miniadv_0022_0001_msg" : "\u6211\u4EEC\u5148\u6765\u89E3\u653E\u201C\u5FD7\u5728\u5FC5\u5F97\u7684\u9009\u62D4\u201D\n\u8FD9\u4E00\u56DE\u5FC6\u7247\u6BB5\u5427\u3002",
    "tuto_miniadv_0023_0000_msg" : "\u8FD9\u4E9B\u662F\u6784\u6210\u8FD9\u4E00\u56DE\u5FC6\u7247\u6BB5\n\u7684\u6240\u6709\u56DE\u5FC6\u5361\u7247\u3002",
    "tuto_miniadv_0023_0001_msg" : "\u70B9\u51FB\u5176\u4E2D\u4EFB\u610F\u4E00\u5F20\u5427\u3002",
    "tuto_miniadv_0024_0000_msg" : "\u89E3\u653E\u56DE\u5FC6\u7247\u6BB5\u76F8\u5173\u7684\u80FD\u529B\u9879\uFF0C\n\u53EF\u83B7\u5F97\u4E00\u5B9A\u91CF\u7684\u56DE\u5FC6\u70B9\u6570\u3002",
    "tuto_miniadv_0024_0001_msg" : "\u53EF\u83B7\u5F97\u70B9\u6570\u7684\u80FD\u529B\u9879\uFF0C\n\u4F1A\u663E\u793A\u56DE\u5FC6\u7247\u6BB5\u7684\u89E3\u653E\u5956\u52B1\u3002",
    "tuto_miniadv_0024_0002_msg" : "\u627E\u5230\u56FE\u6807\u4E3A\u8299\u857E\u96C5\u670D\u88C5\u7684\u80FD\u529B\u9879\uFF0C\n\u7136\u540E\u89E3\u653E\u5B83\u4EEC\u5427\u3002",
    "tuto_miniadv_0025_0000_msg" : "\u4ECE\u4ECA\u5929\u8D77\u4F60\u5C31\u662F\u6211\u4EEC\u7684\u4F19\u4F34\u4E86\uFF01\n\u6B63\u5F0F\u5F00\u59CB\u524D\uFF0C\u53EF\u4EE5\u5148\u8BA9\u6211\u4E86\u89E3\u4E00\u4E9B\u5173\u4E8E\u4F60\u7684\u4E8B\u5417\uFF1F",
    "tuto_miniadv_0025_0001_msg" : "\u4F60\u5BF9Macross\u7CFB\u5217\u559C\u6B22\u7684\u7A0B\u5EA6\u662F\u591A\u5C11\u5462\uFF1F\n\u8BF7\u9009\u62E9\u4F60\u8BA4\u4E3A\u6700\u7B26\u5408\u7684\u4E00\u9879\u5427\u3002",
    "tuto_miniadv_0026_0000_msg" : "\u4F60\u5728\u8FD9\u65B9\u9762\u6709\u591A\u64C5\u957F\u5440\uFF1F\n\u6211\u5417\uFF01\uFF1F\u2026\u6211\u3001\u6211\u7684\u8BDD\uFF0C\u4ECE\u4ECA\u5929\u5F00\u59CB\u4F1A\u52AA\u529B\u63D0\u9AD8\u81EA\u5DF1\u7684\uFF01",
    "tuto_miniadv_0027_0000_msg" : "\u8FD9\u6B21\u7684\u65C5\u7A0B\uFF0C\u4F1A\u6709\u4EC0\u4E48\u5728\u8DEF\u4E0A\u7B49\u5F85\u7740\u6211\u4EEC\u5462\uFF01\n\u8BF7\u544A\u8BC9\u6211\u4F60\u7684\u671F\u5F85\u5427\uFF01",
    "tuto_miniadv_0028_0000_msg" : "\u8C22\u8C22\u4F60\u7684\u5206\u4EAB\uFF01\n\u4ECE\u73B0\u5728\u5F00\u59CB\uFF0C\u6211\u4EEC\u4E00\u8D77\u52A0\u6CB9\u5427\uFF01",
    "tuto_miniadv_0029_0000_msg" : "\u6F14\u51FA\u5706\u6EE1\u5B8C\u6210\u4E86\uFF0C\n\u8F9B\u82E6\u5566\uFF01\n\u4E8B\u4E0D\u5B9C\u8FDF\uFF0C\u6211\u4EEC\u6765\u5FEB\u901F\u5730\u56DE\u987E\u4E00\u4E0B\u6F14\u51FA\u7684\u6D41\u7A0B\u5427\uFF01",
    "tuto_miniadv_0030_0000_msg" : "\u7B2C\u4E00\u6B65\uFF0C\u5148\u6765\u5B8C\u6210\n\u6211\u4EEC\u4E3A\u4F60\u51C6\u5907\u7684\u65B0\u624B\u4EFB\u52A1\u5427\u3002",
    "tuto_miniadv_0030_0001_msg" : "\u524D\u5F80\u201C\u4EFB\u52A1\u201D\u754C\u9762\uFF0C\n\u5373\u53EF\u67E5\u770B\u6240\u6709\u7684\u65B0\u624B\u4EFB\u52A1\u3002",
    "tuto_miniadv_0031_0000_msg" : "\u4E3A\u4E86\u786E\u4FDD\u6F14\u51FA\u80FD\u591F\u987A\u5229\u5B8C\u6210\uFF0C\n\u6211\u4EEC\u5FC5\u987B\u88C5\u5907\u4E0A\u66F4\u52A0\u5F3A\u529B\u7684\u5361\u7247\uFF01\n\u4F7F\u7528\u4E00\u952E\u7F16\u961F\u529F\u80FD\u8BD5\u8BD5\u770B\u5427\u3002",
    "tuto_miniadv_0032_0000_msg" : "\u8FD9\u6837\u5C31\u4E00\u5207\u5C31\u7EEA\u4E86\u3002\n\u968F\u65F6\u53EF\u4EE5\u51FA\u53D1\uFF01",
    "tuto_miniadv_0033_0000_msg" : "\u987A\u5229\u5B8C\u6210\u7B2C\u4E00\u4E2A\u65B0\u624B\u4EFB\u52A1\u4E86\uFF01\n\u524D\u5F80\u4EFB\u52A1\u754C\u9762\u9886\u53D6\u4F60\u7684\u5956\u52B1\u5427\u3002",
    "tuto_miniadv_0034_0000_msg" : "\u70B9\u51FB\u201C\u9886\u53D6\u201D\u6765\u83B7\u53D6\u4EFB\u52A1\u5956\u52B1\u5427\uFF01\n\u4E4B\u540E\u51FA\u73B0\u4EFB\u52A1\u5B8C\u6210\u7684\u63D0\u793A\u65F6\uFF0C\u8BB0\u5F97\u524D\u6765\u67E5\u770B\u54E6\uFF01",
    "tuto_miniadv_0035_0000_msg" : "\u5B8C\u6210\u7B2C\u4E8C\u4E2A\u65B0\u624B\u4EFB\u52A1\u4E86\uFF01\n\u5FEB\u53BB\u9886\u53D6\u4EFB\u52A1\u5956\u52B1\u5427\uFF01",
    "tuto_miniadv_0036_0000_msg" : "\u4E0B\u4E00\u6B65\uFF0C\u6211\u4EEC\u6765\u8BD5\u8BD5\u5BF9\u5361\u7247\u8FDB\u884C\u5F3A\u5316\u5427\uFF01",
    "tuto_miniadv_0037_0000_msg" : "\u5C06\u65B0\u62DB\u52DF\u7684\u6B4C\u59EC\u7F16\u5165\u5230\u961F\u4F0D\u4E2D\u5427\uFF01",
    "tuto_miniadv_0038_0000_msg" : "\u6709\u4E86\u65B0\u6B4C\u59EC\u7684\u52A0\u5165\uFF0C\u961F\u4F0D\u53D8\u5F97\u5F3A\u5927\u4E86\u4E0D\u5C11\uFF01\n\u83B7\u5F97\u4E0B\u4E00\u4F4D\u65B0\u6B4C\u59EC\u65F6\uFF0C\u4E0D\u8981\u5FD8\u8BB0\u5C06ta\u7F16\u5165\u5230\u961F\u4F0D\u4E2D\u53BB\u54E6\u3002",
    "tuto_miniadv_0039_0000_msg" : "\u6F14\u51FA\u5F00\u59CB\u524D\uFF0C\n\u9700\u8981\u5148\u4ECE\u52A9\u6218\u5217\u8868\u4E2D\u9009\u62E9\u4E00\u4F4D\u73A9\u5BB6\u3002\n\u8FD9\u6B21\u6211\u4EEC\u5C31\u5148\u9009\u62E9\u6700\u4E0A\u9762\u7684\u4E00\u4F4D\u5427\u3002",
    "tuto_miniadv_0040_0000_msg" : "\u963F\u62C9\u5FB7\u961F\u957F\u5728\u558A\u6211\u4EEC\u8FC7\u53BB\u3002\n\u8DDF\u6211\u6765\u5427\uFF01",
    "tuto_miniadv_0041_0000_msg" : "\u6709\u5BA2\u6237\u53D1\u6765\u59D4\u6258\u4E86\u3002\n\u70B9\u51FB\u201C\u627F\u63A5\u201D\u6309\u94AE\u6765\u63A5\u4E0B\u8FD9\u9879\u4EFB\u52A1\u5427\uFF01",
    "tuto_miniadv_0042_0000_msg" : "\u7B2C\u4E00\u6B65\u662F\u7EC4\u5EFA\u6218\u6597\u5C0F\u961F\uFF0C\n\u6BCF\u4E2A\u5C0F\u961F\u6700\u591A\u53EF\u5BB9\u7EB3\u4E09\u540D\u6210\u5458\u3002\n\u8FD9\u6B21\u7684\u884C\u52A8\u5C31\u5148\u4EA4\u7ED9\u75BE\u98CE\u6765\u5904\u7406\u5427\u3002",
    "tuto_miniadv_0043_0000_msg" : "\u63A5\u4E0B\u6765\u662F\u9009\u62E9\u6218\u673A\u5F62\u6001\uFF01\n\u89C2\u5BDF\u4E0B\u65B9\u7684\u6570\u636E\uFF0C\u9009\u62E9\u6700\u9002\u5408\u7684\u5F62\u6001\uFF0C\n\u53EF\u4EE5\u6709\u6548\u7F29\u77ED\u5B8C\u6210\u4EFB\u52A1\u6240\u9700\u7684\u65F6\u95F4\u54E6\u3002",
    "tuto_miniadv_0044_0000_msg" : "\u521A\u624D\u89E3\u9501\u4E86\u4E00\u9879\u65B0\u7684\u529F\u80FD\uFF0C\n\u4E00\u8D77\u5230\u6B4C\u59EC\u754C\u9762\u770B\u770B\u5427\u3002",
    "tuto_miniadv_0045_0000_msg" : "\u6240\u6709\u5DF2\u83B7\u5F97\u7684\u670D\u88C5\u90FD\u53EF\u4EE5\u4EA4\u7ED9\u739B\u57FA\u5A1C\u8FDB\u884C\u5F3A\u5316\uFF0C\n\u73B0\u5728\u5C31\u6765\u8BD5\u8BD5\u770B\u5427\uFF01",
    "tuto_miniadv_0046_0000_msg" : "\u9009\u62E9\u4E00\u5957\u670D\u88C5\u4EA4\u7ED9\u5979\u5427\u3002",
    "tuto_miniadv_0047_0000_msg" : "\u73B0\u5728\u53EF\u4EE5\u6311\u6218Bingo\u4EFB\u52A1\u4E86\uFF01\n\u5B8C\u6210\u4EFB\u52A1\u8FD8\u80FD\u83B7\u5F97\u7279\u6B8A\u7684\u56DE\u5FC6\u5361\u7247\u54E6\uFF0C\n\u4E0D\u8981\u9519\u8FC7\u5566\u3002",
    "tuto_miniadv_0048_0000_msg" : "\u521A\u624D\u89E3\u9501\u4E86\u4E00\u9879\u65B0\u7684\u529F\u80FD\uFF0C\n\u4E00\u8D77\u5230\u6B4C\u59EC\u754C\u9762\u770B\u770B\u5427\u3002",
    "tuto_miniadv_0049_0000_msg" : "\u73B0\u5728\u53EF\u4EE5\u5BF9\u6218\u673A\u8FDB\u884C\u5F3A\u5316\u4E86\u3002",
    "tuto_miniadv_0050_0000_msg" : "\u521A\u624D\u89E3\u9501\u4E86\u4E00\u9879\u65B0\u7684\u529F\u80FD\uFF0C\n\u4E00\u8D77\u5230\u6218\u961F\u5927\u5385\u770B\u770B\u5427\u3002",
    "tuto_miniadv_0051_0000_msg" : "\u521A\u624D\u89E3\u9501\u4E86\u4E00\u9879\u65B0\u7684\u529F\u80FD\uFF0C\n\u4E00\u8D77\u5230\u8D85\u65F6\u7A7A\u623F\u95F4\u770B\u770B\u5427\u3002",
    "tuto_miniadv_0052_0000_msg" : "\u603B\u529BLIVE\u5F00\u59CB\u4E86\uFF01\n\u901A\u8FC7\u6218\u961F\u5927\u5385\u8FDB\u5165\u6D3B\u52A8\u4F1A\u573A\u5427\u3002",
    "tuto_miniadv_0053_0000_msg" : "\u6218\u6597\u5F00\u59CB\u524D\uFF0C\u6211\u4EEC\u9700\u8981\u5148\u5728\u6218\u573A\u4E0A\u627E\u5230\u66B4\u8D70\u7684\u654C\u4EBA\u3002\n\u4F7F\u7528Fold\u96F7\u8FBE\u8FDB\u884C\u641C\u7D22\u5427\u3002",
    "tuto_miniadv_0053_0001_msg" : "\u6211\u8FD9\u91CC\u4E3A\u4F60\u51C6\u5907\u4E86\u4E00\u4E2A\uFF0C\n\u9A6C\u4E0A\u6765\u4F7F\u7528\u770B\u770B\u5427\uFF01",
    "tuto_miniadv_0054_0000_msg" : "\u6210\u529F\u53D1\u73B0\u76EE\u6807\u4E86\u3002\n\u8D76\u5FEB\u52A0\u5165\u6218\u6597\u51FB\u8D25\u5B83\u5427\uFF01",
    "tuto_miniadv_0055_0000_msg" : "\u73B0\u5728\u53EF\u4EE5\u8FDB\u884C5\u4EBA\u6F14\u51FA\u4E86\uFF01\n\u9996\u5148\u6765\u6311\u9009\u5C06\u8981\u4E0A\u573A\u7684\u6B4C\u59EC\u9635\u5BB9\u5427\u3002",
    "tuto_miniadv_0055_0001_msg" : "\u70B9\u51FB\u53F3\u4E0B\u89D2\u7684\u7BAD\u5934\u6309\u94AE\u3002",
    "tuto_miniadv_0056_0000_msg" : "\u73B0\u5728\u53EF\u4EE5\u5BF9\u5373\u5C06\u4E0A\u573A\u7684\u6B4C\u59EC\u8FDB\u884C\u6311\u9009\u4E86\u3002",
    "tuto_miniadv_0056_0001_msg" : "\u8981\u6CE8\u610F\u7684\u662F\uFF0C\u961F\u4F0D\u4E24\u4FA7\u6B4C\u59EC\u7684\u80FD\u529B\u503C\n\u5C06\u4E0D\u4F1A\u8BA1\u7B97\u5230\u961F\u4F0D\u4E4B\u4E2D\u3002\n\u7EC4\u5EFA\u597D\u9635\u5BB9\u5C31\u53EF\u4EE5\u5F00\u59CB\u6F14\u51FA\u4E86\uFF01"
