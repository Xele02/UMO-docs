
{
    "tuto_miniadv_0000_0000_msg" : "\uCD9C\uACA9 \uC804\uC5D0 \uB178\uD2B8 \uD0C0\uC774\uBC0D\uC774\n\uC5B4\uAE0B\uB098\uC9C0\uB294 \uC54A\uC558\uB294\uC9C0 \uD655\uC778\uD560\uAC8C.",
    "tuto_miniadv_0000_0001_msg" : "\uB4E4\uB824\uC624\uB294 \uC18C\uB9AC\uC5D0 \uB9DE\uCDB0\n\uB9AC\uB4EC \uBC84\uD2BC\uC744 \uB20C\uB7EC\uBD10.",
    "tuto_miniadv_0001_0000_msg" : "\uC774\uC81C \uC900\uBE44 OK.\n\uCD9C\uACA9\uD558\uC790!",
    "tuto_miniadv_0002_0000_msg" : "\uC774\uBC88\uC744 \uC704\uD574 \uB9E4\uB274\uC5BC\uC744 \uB9CC\uB4E4\uC5C8\uC5B4.\n\uD568\uAED8 \uC0B4\uD3B4\uBCF4\uC790.",
    "tuto_miniadv_0002_0001_msg" : "\uC5ED\uC2DC \uCE74\uB098\uBA54 \uC528!\n\uC774 \uB9E4\uB274\uC5BC\uB9CC \uBCF4\uBA74 \uB41C\uB2E4\uB294 \uAC70\uB124\uC694!",
    "tuto_miniadv_0003_0000_msg" : "...\uC6B0\uB9AC \uB178\uB798\uAC00 \uD6A8\uACFC\uAC00 \uC5C6\uB2E4\uACE0?\n\uD504\uB808\uC774\uC544, \uB354 \uC774\uC0C1\uC740 \uC704\uD5D8\uD574.\n\uC77C\uB2E8 \uB3CC\uC544\uC640!",
    "tuto_miniadv_0004_0000_msg" : "\u3010\uC5D0\uD53C\uC18C\uB4DC \uD50C\uB808\uC774\uD2B8\u3011\uB294 \uC6B0\uB9AC\uB4E4\uC758 \uB178\uB798\uB85C \uBCF5\uC6D0\uB41C\n\uAE30\uC5B5\uC744 \uAC1C\uB150\uD654\uD558\uC5EC \uC804\uC790 \uC815\uBCF4\uB85C \uAE30\uB85D\uD55C \uAC70\uC57C.",
    "tuto_miniadv_0005_0000_msg" : "\u3010\uC5D0\uD53C\uC18C\uB4DC \uD50C\uB808\uC774\uD2B8\u3011\uB294 \uB2E4\uC591\uD55C \uBC29\uBC95\uC73C\uB85C\n\uD68D\uB4DD\uD560 \uC218 \uC788\uC5B4.",
    "tuto_miniadv_0005_0001_msg" : "\uC774\uBC88\uC5D0\uB294 \u3010\uAC00\uCC60\u3011\uB97C \uBF51\uC544\uC11C \uD68D\uB4DD\uD574 \uBCF4\uC790!",
    "tuto_miniadv_0005_0002_msg" : "\uAC00\uCC60\uC5D0 \uD544\uC694\uD55C \u3010\uAC00\uC815\uC11D\u3011\uB3C4 \uC900\uBE44\uD588\uC5B4.\n\uC5B4\uB5A4 \uD50C\uB808\uC774\uD2B8\uAC00 \uB098\uC62C\uC9C0 \uAE30\uB300\uB418\uB124.",
    "tuto_miniadv_0006_0000_msg" : "\uC774\uAC74...\n\uB0B4\uAC00 \uC624\uB514\uC158\uC5D0 \uD569\uACA9\uD55C \uB0A0?",
    "tuto_miniadv_0006_0001_msg" : "\u3010\uC5D0\uD53C\uC18C\uB4DC \uD50C\uB808\uC774\uD2B8\u3011\uC5D0 \uB5A0\uC624\uB974\uB294 \uAC83\uC740\n\uC6B0\uB9AC\uC640 \uAD00\uB828\uB41C \uAE30\uC5B5\uC758 \uC774\uBBF8\uC9C0\uB77C\uB294 \uAC83 \uAC19\uC544.",
    "tuto_miniadv_0007_0000_msg" : "\u3010\uC5D0\uD53C\uC18C\uB4DC \uD50C\uB808\uC774\uD2B8\u3011\uC758 \uD798\uC740 \uC6B0\uB9AC\uAC19\uC740 \uAC00\uD76C\uB4E4\uC774\n\uCC29\uC6A9\uD574\uC57C\uB9CC \uADF8 \uD798\uC744 \uBC1C\uD718\uD560 \uC218 \uC788\uC5B4.\n\uBC29\uBC95\uC744 \uC124\uBA85\uD574 \uC904\uAC8C.",
    "tuto_miniadv_0008_0000_msg" : "\uBA3C\uC800 \u3010\uC720\uB2DB \uD3B8\uC131\u3011\uC744 \uC120\uD0DD\uD574 \uBD10.",
    "tuto_miniadv_0009_0000_msg" : "\u3010\uC720\uB2DB\u3011\uC740 \uAC00\uD76C\uC640 \uC5D0\uD53C\uC18C\uB4DC \uD50C\uB808\uC774\uD2B8\uC758\n\uC870\uD569\uC73C\uB85C \uC774\uB8E8\uC5B4\uC838 \uC788\uC5B4.",
    "tuto_miniadv_0009_0001_msg" : "\uC790, \uC785\uC218\uD55C \uC5D0\uD53C\uC18C\uB4DC \uD50C\uB808\uC774\uD2B8\uB85C\n\uBC14\uB85C \uAC15\uD654\uD574 \uBCF4\uC790.",
    "tuto_miniadv_0010_0000_msg" : "\uC5D0\uD53C\uC18C\uB4DC \uD50C\uB808\uC774\uD2B8\uB85C \uB178\uB798\uC758 \uD798\uC774 \uB354 \uAC15\uD574\uC84C\uC5B4!\n\uC9C0\uAE08\uC774\uB77C\uBA74 \uBCF4\uB2E4 \uAC15\uB825\uD55C \uC0DD\uCCB4 \uD3F4\uB4DC\uD30C\uB97C\n\uBC1C\uC0DD\uC2DC\uD0AC \uC218 \uC788\uC744 \uAC83 \uAC19\uB124.",
    "tuto_miniadv_0011_0000_msg" : "\uC5EC\uAE30\uC5D0\uC11C\uB294 \uC6B0\uB9AC \uC648\uD050\uB808\uB97C \uD3EC\uD568\uD55C \uBAA8\uB4E0 \uC740\uD558\uC758 \uC0AC\uB78C\uB4E4\uACFC\n\uC2DC\uACF5\uC744 \uCD08\uC6D4\uD558\uC5EC \uD1B5\uC2E0\uC744 \uD560 \uC218 \uC788\uC5B4.",
    "tuto_miniadv_0011_0001_msg" : "\uC2DC\uACF5\uC744 \uCD08\uC6D4\uD55C\uB2E4?",
    "tuto_miniadv_0011_0002_msg" : "\uADF8\uAC74 \uC9C1\uC811 \uB208\uC73C\uB85C \uD655\uC778\uD558\uB294 \uAC8C \uB354 \uBE60\uB97C \uAC83 \uAC19\uB124.",
    "tuto_miniadv_0011_0003_msg" : "\uC790, \uBA3C\uC800 \uBC29\uC744 \uC120\uD0DD\uD558\uC790.\n\uC774\uBC88\uC5D0\uB294 \u3010SNS \uC5F0\uB77D\uBC29\u3011\uC744 \uC120\uD0DD\uD574\uBD10.",
