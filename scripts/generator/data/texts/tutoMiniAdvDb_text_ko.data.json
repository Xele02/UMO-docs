    "tuto_miniadv_0012_0001_msg" : "\uC751, \uC798\uD588\uC5B4.",
    "tuto_miniadv_0013_0000_msg" : "\uC624\uC624, \uBBF8\uCFE0\uBAA8 \uC528, \uB9C8\uD0A4\uB098 \uC528\uB791 \uB808\uC774\uB098 \uC528!\n\uC648\uD050\uB808 \uBA64\uBC84\uB4E4\uC774 \uC804\uBD80 \uC788\uB124!",
    "tuto_miniadv_0013_0001_msg" : "\uB2E4\uB978 \uBA64\uBC84\uB4E4\uC740 \uBA3C\uC800 \uB4F1\uB85D\uD588\uAC70\uB4E0.\n\uC790, \uADF8\uB7FC \uBC14\uB85C \uB300\uD654\uB97C \uC2DC\uC791\uD574\uBCF4\uC790!",
    "tuto_miniadv_0014_0000_msg" : "\uC774 \uB370\uC774\uD130\uBCA0\uC774\uC2A4\uC5D0\uB294 \uD604\uC7AC \uC0C8\uC778\uAC04\uC758 \uC704\uD611\uC5D0\n\uB9DE\uC11C\uACE0 \uC788\uB294 \uAC00\uD76C\uB4E4\uC774 \uB4F1\uB85D\uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.",
    "tuto_miniadv_0014_0001_msg" : "\uC0C8\uC778\uAC04\uC758 \uC704\uD611\uC5D0 \uB300\uD56D\uD558\uAE30 \uC704\uD574\uC11C\uB294,\n\uAC00\uD76C \uC5EC\uB7EC\uBD84\uC774 \uAC00\uC9C4 \uB178\uB798\uC758 \uD798\uACFC \uB2F9\uC2E0\uC758 \uD611\uB825\uC774\n\uBC18\uB4DC\uC2DC \uD544\uC694\uD569\uB2C8\uB2E4.",
    "tuto_miniadv_0014_0002_msg" : "\uBA3C\uC800 \uD568\uAED8 \uC2F8\uC6B8 \uAC00\uD76C\uB97C \uC120\uD0DD\uD574 \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?",
    "tuto_miniadv_0014_0003_msg" : "\uB2E4\uB9CC \uBC00\uB808\uB290 \uC528\uC640 \uBC14\uC0AC\uB77C \uC528\uB294 \uC2DC\uACF5\uC774\n\uC548\uC815\uB418\uC9C0 \uC54A\uC558\uAE30 \uB54C\uBB38\uC5D0\n\uC544\uC9C1\uC740 \uD568\uAED8 \uC2F8\uC6B8 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.",
    "tuto_miniadv_0014_0004_msg" : "\uD558\uC9C0\uB9CC \uC5B8\uC820\uAC00\uB294 \uD568\uAED8 \uC2F8\uC6B8 \uC218 \uC788\uC744 \uAC81\uB2C8\uB2E4.",
