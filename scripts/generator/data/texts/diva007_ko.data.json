
{
    "talk_time_01" : "\uB0B4 \uC0DD\uB77C\uC774\uBE0C\uB97C \uBCFC \uC218 \uC788\uB294 \uAC70\uC57C\n\uAC10\uC0AC\uD558\uB77C\uAD6C",
    "talk_time_02" : "\uCEE8\uB514\uC158 \uAD00\uB9AC\uB3C4 \uC77C\uC758 \uD558\uB098.\n\uAC8C\uC73C\uB984 \uD53C\uC6B0\uBA74 \uC548\uB3FC",
    "talk_time_03" : "\uC557!\n\uC9C0\uAE08 \uC88B\uC740 \uC545\uC0C1\uC774 \uB5A0\uC62C\uB790\uC5B4!",
    "talk_time_04" : "\uC740\uD558\uC758 \uC694\uC815\uC774\uB780 \uB9D0,\n\uAF64 \uC88B\uC740 \uD638\uCE6D\uC774\uB77C\uACE0 \uC0DD\uAC01\uD558\uC9C0 \uC54A\uC544?",
    "talk_time_05" : "\uBB58, \uBE64\uD788 \uB4E4\uC5EC\uB2E4\uBD10\u2026\n\uC5B4\uBA38, \uB098\uD55C\uD14C \uBC18\uD588\uC5B4?",
    "talk_time_06" : "\uC7A0\uAE50...\n\uB098\uB97C \uB450\uACE0 \uC5B4\uB514\uB85C \uAC04\uAC70\uC57C?",
